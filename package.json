{
  "name": "dobrapay",
  "version": "0.1.0",
  "description": "Carteira móvel para São Tomé e Príncipe: enviar, receber e pedir dinheiro em Dobras (STN), com rede de agentes para depósito e levantamento.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "ssh2-sftp-client": "^11.0.0",
    "web-push": "^3.6.7"
  }
}
